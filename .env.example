# dump1090-stack environment - copy to .env and edit:
#
#   cp .env.example .env
#
# Every variable referenced as ${VAR} in compose.yaml is listed here.
# Values shown are the defaults compose.yaml falls back to when the
# variable is unset, so an empty .env is equivalent to this file.

# -- General ----------------------------------------------------------------
# Timezone for every container (also baked into timestamps of recordings).
TZ=UTC

# -- Decoder: readsb --------------------------------------------------------
# Decoder image. ghcr.io/wiedehopf/readsb is the image built by the readsb
# repository itself (readsb with RTL-SDR support compiled in).
READSB_IMAGE=ghcr.io/wiedehopf/readsb:latest
# true  -> container runs privileged so it can open /dev/bus/usb (RTL-SDR).
# false -> required for --net-only remote feeds and on Docker Desktop,
#          where USB pass-through does not exist.
READSB_PRIVILEGED=true
# SDR type: rtlsdr (default), none (network-only), or any other type the
# readsb image supports (bladerf, hackrf, ...).
READSB_DEVICE_TYPE=rtlsdr
# Extra readsb arguments appended verbatim to the command line. Typical
# remote-feed setup (no local dongle, pull Beast from another receiver):
#   READSB_ARGS=--net-only --net-connector 192.168.1.10,30005,beast_in
# Receiver position for aircraft.json / tar1090 (optional):
#   READSB_ARGS=--lat=51.47 --lon=-0.45
READSB_ARGS=
# readsb HTTP API port on the host (/?box=, /?circle=, /?find_hex=, ...).
READSB_API_PORT=8042
# Host directory that receives the decoder JSON output (aircraft.json,
# receiver.json, stats.json, history_NNN.json) and feeds tar1090/exporter.
READSB_DATA_DIR=./data/readsb

# -- Web UI: tar1090 --------------------------------------------------------
# Host port for the tar1090 map UI (http://localhost:<port>/).
TAR1090_PORT=8080

# -- Metrics: dump1090-exporter ---------------------------------------------
# Decoder origin the exporter scrapes. It must serve /data/aircraft.json,
# which is what tar1090's nginx does for this stack.
DUMP1090_URL=http://tar1090

# -- Monitoring: Prometheus -------------------------------------------------
# Host port for the Prometheus UI/API (bound to 127.0.0.1 only).
PROMETHEUS_PORT=9090
# Local TSDB retention for decoder metrics.
PROMETHEUS_RETENTION=15d

# -- Dashboards: Grafana ----------------------------------------------------
# Host port for Grafana (http://localhost:<port>/).
GRAFANA_PORT=3000
# Initial admin account; change the password before exposing the port.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# -- Alerting: Alertmanager -------------------------------------------------
# Host port for the Alertmanager UI (bound to 127.0.0.1 only).
ALERTMANAGER_PORT=9093

# -- Optional: recorder profile (docker compose --profile recorder up) ------
# Beast endpoint to record from (host.docker.internal = this machine,
# because readsb runs with network_mode: host).
RECORD_HOST=host.docker.internal
RECORD_PORT=30005
# Seconds per output file before the recorder rotates.
RECORD_INTERVAL=900
# Host directory that stores the recorded Beast streams.
RECORD_DATA_DIR=./recordings
